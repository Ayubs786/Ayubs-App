# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Supabase — get from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxx

# App password — pick anything strong, this is what protects the app
APP_PASSWORD=your-strong-password-here

# Auth secret — used to sign cookies, generate any random string
AUTH_SECRET=any-long-random-string-32-chars-or-more
